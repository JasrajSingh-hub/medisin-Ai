# Choose the text-to-speech provider: 'edge' (online, high quality) or 'pyttsx3' (offline, native OS)
TTS_PROVIDER=edge

# FastAPI TTS Service Port
TTS_PORT=5001

# Rate limiting settings (max requests per client IP per window)
RATE_LIMIT_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60

# FastAPI OCR Service Configuration
OCR_PORT=5002
OCR_RATE_LIMIT_LIMIT=30
OCR_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=temp_uploads
DB_PATH=prescriptions.db
